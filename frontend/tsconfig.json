{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": false,

    "jsx": "preserve",
    "sourceMap": true,
    "noEmit": true,

    "resolveJsonModule": true,
    "esModuleInterop": true,

    "lib": ["ESNext", "DOM"],

    "types": ["vite/client"],

    "allowJs": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ]
}